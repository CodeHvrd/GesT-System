# Copiá este archivo como .env (en la raíz del proyecto) y completá los valores.
# Nunca lo subas a un repositorio: .gitignore ya lo excluye.
#
# Neon → botón "Connect". Se usan dos cadenas:
#   · Pooled (host con -pooler) → DATABASE_URL        (la web)
#   · Direct (sin -pooler)      → DATABASE_URL_DIRECT (migraciones y scripts)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Managed Better Auth (etapa de login; opcional por ahora)
NEON_AUTH_URL=https://ep-xxxx.neonauth.sa-east-1.aws.neon.tech/neondb/auth

# Fudo → Administración → Usuarios → usuario de API
FUDO_API_KEY=
FUDO_API_SECRET=
